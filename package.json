{
  "name": "fivem-ringmaster",
  "version": "0.1.0",
  "private": true,
  "description": "Admin, moderation and observability console for FiveM Royale",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:secrets && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:secrets && npm run check:banrule && npm run check:xpcurve && npm run check:verdict && npm run check:artifacts && npm run check:discordrole && npm run check:handoff && npm run check:origin && npm run check:framed && npm run check:chips && npm run check:deployphase && npm run check:deploytarget && npm run check:timeline && npm run check:actionbar && npm run check:ddbhealth && npm run check:contrast && npm run check:cef && npm run typecheck && npm run lint",
    "check:xpcurve": "tsx scripts/check-xp-curve.mjs",
    "check:banrule": "node scripts/check-ban-rule.mjs",
    "check:verdict": "tsx scripts/check-verdict-contract.mjs",
    "check:artifacts": "tsx scripts/check-artifact-keys.mjs",
    "check:discordrole": "tsx src/lib/discordRole.check.ts",
    "check:handoff": "tsx src/lib/handoff.check.ts",
    "check:origin": "tsx src/lib/origin.check.ts",
    "check:chips": "tsx scripts/check-chip-suppression.mjs",
    "check:deployphase": "tsx scripts/check-deploy-phase.mjs",
    "check:deploytarget": "tsx scripts/check-deploy-target.mjs",
    "check:timeline": "tsx src/lib/matchTimeline.check.ts",
    "check:actionbar": "tsx src/lib/actionBar.check.ts",
    "check:ddbhealth": "tsx scripts/check-ddb-health.mjs",
    "check:contrast": "tsx scripts/check-contrast.mjs",
    "check:cef": "node scripts/check-cef-css.mjs",
    "check:framed": "tsx src/lib/framed.check.ts"
  },
  "dependencies": {
    "@auth/dynamodb-adapter": "^2.7.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^5.0.8",
    "@csstools/postcss-progressive-custom-properties": "^5.1.2",
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
